# Microsoft owns the voice data and the SAPI engine binaries. Nothing matching these
# may ever be committed; tools/check_no_microsoft_files.sh fails CI on a match.
*.spd
*.sdf
*.lxa
*.LXA
spttseng.dll
sapi.dll
spcommon.dll
*.exe
*.cab
*.msi

# a checkout of the voice pack, wherever the operator puts it
data/voice/
voice/

# rendered audio: derived from Microsoft's data, so not distributable either
out/
*.wav

# build output
serve/sapi_serve
serve/*.o
third_party/*/build/
# generated by the engine's own build step from the voice pack
third_party/*/src/sam_data.c
third_party/*/data/voice
tools/build/
tools/crash-*
